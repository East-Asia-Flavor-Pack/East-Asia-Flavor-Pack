@panel_width = 540
@panel_width_plus_14 = 554

types eafp_chinese_interregnum
{
	type eafp_chinese_interregnum_order_item = flowcontainer {
		parentanchor = center
		spacing = 20

		widget = {
			size = { 25 25 }
		}

		widget = {
			minimumsize = { 350 15 }
			parentanchor = vcenter

			levels_progressbar = {
				datamodel = "[GetCohesionLevels]"
				position = { 0 2 }

				blockoverride "item_properties" {
					layoutstretchfactor_horizontal = "[FixedPointToInt(CohesionLevel.GetWidth)]"
					tooltip = "[SelectLocalization( CohesionLevel.IsActive( PowerBloc.GetCohesion ), 'COHESION_LEVEL_ACTIVE_TOOLTIP', 'COHESION_LEVEL_INACTIVE_TOOLTIP' )]"
				}

				blockoverride "level_active" {
					visible = "[CohesionLevel.IsActive( PowerBloc.GetCohesion )]"
				}

				blockoverride "last_level" {
					visible = "[Not(EqualTo_CFixedPoint(CohesionLevel.GetUpperBound,GetDefine('NPowerBlocs','COHESION_TARGET_MAX')))]"
				}

				blockoverride "default_progressbar_value" {
					value = "[CohesionLevel.GetProgress( PowerBloc.GetCohesion )]"
				}
			}
		}

		flowcontainer = {
			direction = vertical
			parentanchor = vcenter
			minimumsize = { 50 40 }
			maximumsize = { 80 65 }
			datacontext = "[PowerBloc.GetCohesionLevel]"
			tooltip = "COHESION_LEVEL_ACTIVE_TOOLTIP"

			textbox = {
				align = nobaseline
				parentanchor = hcenter
				text = "POWER_BLOC_COHESION"
				autoresize = yes
				elide = right
			}

			flowcontainer = {
				spacing = 2
				parentanchor = hcenter

				icon = {
					size = { 25 25 }
					texture = "gfx/interface/icons/generic_icons/cohesion.dds"
				}

				textbox = {
					align = nobaseline
					parentanchor = vcenter
					raw_text = "[PowerBloc.GetCohesion|v0]"
					autoresize = yes
					elide = right
				}
			}
		}
	}

	type eafp_chinese_interregnum_widget = flowcontainer {
		using = default_list_position
		direction = vertical
		minimumsize = { @panel_width -1 }
		maximumsize = { @panel_width -1 }
		margin = { 6 2 }
		spacing = 8

		default_header_2texts = {
			blockoverride "text1" {
				text = eafp_chinese_interregnum_central_government
			}
			block "size" {
				size = { 508 44 }
			}
		}

		container = {
			minimumsize = { 500 54 }
			maximumsize = { 500 54 }
			parentanchor = hcenter
			background = {
				using = entry_bg_simple
			}

			textbox = {
				text = "[GetGlobalVariable('chinese_central_government').GetCountry.GetName]"
				size = { 100% 26 }
				align = hcenter
				margin_top = 6
			}
			textbox = {
				text = eafp_chinese_interregnum_central_government_desc
				size = { 100% 22 }
				position = { 0 28 }
				align = hcenter
			}
		}

		flowcontainer = {
			parentanchor = hcenter
			direction = vertical

			background = {
				using = fade_right_simple
				texture = "[PowerBloc.GetMapTexture]"
				color = "[PowerBloc.GetPrimaryColor]"
				alpha = 0.2
			}

			widget = {
				size = { @panel_width_plus_14 95 }
				parentanchor = hcenter

				widget = {
					size = { 500 76 }
					parentanchor = vcenter|right

					eafp_chinese_interregnum_order_item = {}

					icon = {
						position = { 45 16 }
						size = { 73% 70% }
						texture = "gfx/interface/progressbar/cohesion_bar.dds"
					}
				}

				icon = {
					parentanchor = vcenter|left
					size = { 85 85 }
					position = { 10 0 }
					texture = "[PowerBloc.GetFlag.GetMediumPowerBlocCoaTexture]"
					frame = "[PowerBloc.GetFlag.GetMediumPowerBlocCoaFrame]"
					framesize = "[GetMediumPowerBlocCoaFrameSize]"

					tooltipwidget = {
						FancyTooltip_PowerBloc = {}
					}
				}
			}
		}
	}
}

flowcontainer = {
	name = "widget_je_chinese_interregnum_order"
	ignoreinvisible = yes
	datacontext = "[GetGlobalVariable('chinese_central_government').GetCountry.GetPowerBloc]"

	eafp_chinese_interregnum_widget = {}
}
