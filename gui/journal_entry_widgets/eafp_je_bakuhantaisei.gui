                min = 0
                max = 100
                value = "[JournalEntry.GetCountry.MakeScope.Var('eafp_japan_independency_SHIKOKU').GetValue]"
                noprogresstexture = "gfx/interface/progressbar/progressbar_empty.dds"
                progresstexture = "gfx/interface/progressbar/progressbar_bad.dds"
            }
        }
    }
    flowcontainer = {
        direction = vertical
        spacing = 3
        textbox = { text = "STATE_KYUSHU" autoresize = yes }
        textbox = {
            visible = "[Not(JournalEntry.GetCountry.MakeScope.Var('eafp_japan_region_active_KYUSHU').IsSet)]"
            text = "eafp_japan_region_unavailable"
            autoresize = yes
        }
        flowcontainer = {
            visible = "[JournalEntry.GetCountry.MakeScope.Var('eafp_japan_region_active_KYUSHU').IsSet]"
            direction = vertical
            spacing = 3
            textbox = { text = "eafp_japan_region_loyalty_KYUSHU_text" autoresize = yes tooltip = "eafp_japan_region_loyalty_desc" }
            progressbar = {
                size = { 500 10 }
                min = 0
                max = 100
                value = "[JournalEntry.GetCountry.MakeScope.Var('eafp_japan_loyalty_KYUSHU').GetValue]"
                noprogresstexture = "gfx/interface/progressbar/progressbar_empty.dds"
                progresstexture = "gfx/interface/progressbar/progressbar_green.dds"
            }
            textbox = { text = "eafp_japan_region_independency_KYUSHU_text" autoresize = yes tooltip = "eafp_japan_region_independency_desc" }
            progressbar = {
                size = { 500 10 }
                min = 0
                max = 100
                value = "[JournalEntry.GetCountry.MakeScope.Var('eafp_japan_independency_KYUSHU').GetValue]"
                noprogresstexture = "gfx/interface/progressbar/progressbar_empty.dds"
                progresstexture = "gfx/interface/progressbar/progressbar_bad.dds"
            }
        }
    }
}
