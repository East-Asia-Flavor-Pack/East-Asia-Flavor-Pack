# COPY-PASTED FOR NOW
@panel_width_minus_40 = 500
@panel_width_minus_30 = 510
@panel_width_minus_20 = 520	
@panel_width_minus_10 = 530			# used to be 450
@panel_width = 540  				# used to be 460
@panel_width_half = 270				# used to be 230
@panel_width_plus_10 = 550  		# used to be 470
@panel_width_plus_14 = 554			# used to be 474
@panel_width_plus_14_half = 277		# used to be 237
@panel_width_plus_20 = 560			# used to be 480
@panel_width_plus_30 = 570			# used to be 490
@panel_width_plus_70 = 610			# used to be 530

types eafp_bakuhantaisei {
	type eafp_council_of_elders = container {
		
		using = sidepanel_plus_sidebar_size
		layoutpolicy_vertical = expanding
		alwaystransparent = no
		using = clickthrough_blocker
		layer = layer_ingame_menu

		flowcontainer = {
			using = default_list_position
			direction = vertical
			minimumsize = { @panel_width_minus_20 -1 }
			maximumsize = { @panel_width_minus_20 -1 }
			margin = { 0 16 }
			spacing = 10
			
			container = { # 대로
				flowcontainer = {
					margin = { 0 0 }
					parentanchor = vcenter
					spacing = 5
					direction = vertical
					section_header_button = {
						blockoverride "layout" {
							parentanchor = hcenter
							size = { @panel_width_minus_40 38 }
						}
		
						blockoverride "left_text" {
							text = "TAIRO"
						}

						blockoverride "right_text" {
							section_header_right_text = {
								visible = "[Not(JournalEntry.GetCountry.MakeScope.Var('tairo_var').IsSet)]"
								raw_text = "0/1"
							}
							section_header_right_text = {
								visible = "[JournalEntry.GetCountry.MakeScope.Var('tairo_var').IsSet]"
								raw_text = "1/1"
							}
						}
		
						blockoverride "onclick" {
							onclick = "[GetVariableSystem.Toggle( 'eafp_tairo' )]"
						}
	
						blockoverride "onclick_showmore" {
							visible = "[Not(GetVariableSystem.Exists( 'eafp_tairo' ))]"
						}
		
						blockoverride "onclick_showless" {
							visible = "[GetVariableSystem.Exists( 'eafp_tairo' )]"
						}
					}

					container = {
						visible = "[GetVariableSystem.Exists( 'eafp_tairo' )]"
						parentanchor = hcenter
						container = {
							visible = "[JournalEntry.GetCountry.MakeScope.Var('tairo_var').IsSet]"
							widget = {
								using = entry_bg_fancy
								size = { 480 180 }
								eafp_council_of_elders_item = {
									parentanchor = center
									datacontext = "[JournalEntry.GetCountry.MakeScope.Var('tairo_var').GetCharacter]"
								}
							}
						}
						widget = {
							visible = "[Not(JournalEntry.GetCountry.MakeScope.Var('tairo_var').IsSet)]"
							using = entry_bg_fancy
							size = { 480 180 }
							empty_state_dynamic_width = {
								parentanchor = center
								autoresize = yes
								text = "VACANCIES"
							}
						}
					}
				}
			}

			container = { # 노중 수좌
				flowcontainer = {
					margin = { 0 0 }
					parentanchor = vcenter
					spacing = 5
					direction = vertical
					section_header_button = {
						blockoverride "layout" {
							parentanchor = hcenter
							size = { @panel_width_minus_40 38 }
						}
		
						blockoverride "left_text" {
							text = "ROJUSHUZA"
						}

						blockoverride "right_text" {
							section_header_right_text = {
								visible = "[Not(JournalEntry.GetCountry.MakeScope.Var('rojushuza_var').IsSet)]"
								raw_text = "0/1"
							}
							section_header_right_text = {
								visible = "[JournalEntry.GetCountry.MakeScope.Var('rojushuza_var').IsSet]"
								raw_text = "1/1"
							}
						}
		
						blockoverride "onclick" {
							onclick = "[GetVariableSystem.Toggle( 'eafp_rojushuza' )]"
						}
	
						blockoverride "onclick_showmore" {
							visible = "[Not(GetVariableSystem.Exists( 'eafp_rojushuza' ))]"
						}
		
						blockoverride "onclick_showless" {
							visible = "[GetVariableSystem.Exists( 'eafp_rojushuza' )]"
						}
					}

					container = {
						visible = "[GetVariableSystem.Exists( 'eafp_rojushuza' )]"
						parentanchor = hcenter
						container = {
							visible = "[JournalEntry.GetCountry.MakeScope.Var('rojushuza_var').IsSet]"
							widget = {
								using = entry_bg_fancy
								size = { 480 180 }
								eafp_council_of_elders_item = {
									parentanchor = center
									datacontext = "[JournalEntry.GetCountry.MakeScope.Var('rojushuza_var').GetCharacter]"
								}
							}
						}
						widget = {
							visible = "[Not(JournalEntry.GetCountry.MakeScope.Var('rojushuza_var').IsSet)]"
							using = entry_bg_fancy
							size = { 480 180 }
							empty_state_dynamic_width = {
								parentanchor = center
								autoresize = yes
								text = "VACANCIES"
							}
						}
					}
				}
			}

			container = { # 노중
				flowcontainer = {
					margin = { 0 0 }
					spacing = 5
					direction = vertical
					parentanchor = vcenter
					section_header_button = {
						blockoverride "layout" {
							parentanchor = hcenter
							size = { @panel_width_minus_40 38 }
						}
		
						blockoverride "left_text" {
							text = "ROJU"
						}

						blockoverride "right_text" {
							section_header_right_text = {
								raw_text = "[GetDataModelSize(JournalEntry.GetCountry.MakeScope.GetList('roju_varlist'))]/4"
							}
						}

						blockoverride "onclick" {
							onclick = "[GetVariableSystem.Toggle( 'eafp_roju' )]"
						}
						
						blockoverride "onclick_showmore" {
							visible = "[Not(GetVariableSystem.Exists( 'eafp_roju' ))]"
						}
		
						blockoverride "onclick_showless" {
							visible = "[GetVariableSystem.Exists( 'eafp_roju' )]"
						}
					}
					container = {
						visible = "[GetVariableSystem.Exists( 'eafp_roju' )]"
						parentanchor = hcenter
						flowcontainer = {
							visible = "[Not(IsDataModelEmpty(JournalEntry.GetCountry.MakeScope.GetList('roju_varlist')))]"
							datamodel = "[JournalEntry.GetCountry.MakeScope.GetList('roju_varlist')]"
							spacing = 5
							direction = vertical
							item = {
								widget = {
									using = entry_bg_fancy
									size = { 480 180 }
									eafp_council_of_elders_item = {
										parentanchor = center
										datacontext = "[Scope.GetCharacter]"
									}
								}
							}
						}
						widget = {
							#visible = "[LessThan_int32( GetDataModelSize(JournalEntry.GetCountry.MakeScope.GetList('roju_varlist')), '(int32)5' )]"
							visible = "[IsDataModelEmpty(JournalEntry.GetCountry.MakeScope.GetList('roju_varlist'))]"
							using = entry_bg_fancy
							size = { 480 180 }
							empty_state_dynamic_width = {
								parentanchor = center
								autoresize = yes
								text = "VACANCIES"
							}
						}
					}
				}
			}
		}
	}


	type eafp_council_of_elders_item = hbox {
		margin = { 0 0 }
		
		flowcontainer = {
			direction = vertical
			character_portrait_large = {
				parentanchor = hcenter
				blockoverride "show_hat" {}
				blockoverride "highlight" {}
			}
			default_header_clean_faded = {
				parentanchor = hcenter
				size = { 200 30 }
				blockoverride "text" {
					text = "[Character.GetFullName]"
				}
				blockoverride "text_size" {
					using = fontsize_medium
				}
			}
		}
		vertical_divider = { }
		flowcontainer = {
			direction = vertical
			minimumsize = { 240 -1 }
			margin = { 0 10 }
			
			background =  {
				using = entry_bg_fancy_dark
				alpha = 0.3
			}
			
			### IDEOLOGY
			character_stats_entry = {
				datacontext = "[Character.GetIdeology]"

				tooltipwidget = {
					FancyTooltip_Ideology = {}
				}
				blockoverride "icon_texture" {
					texture = "[Ideology.GetTexture]"
				}
				blockoverride "double_entry_label" {
					text = "IDEOLOGY_CONCEPT"
				}
				blockoverride "double_entry_value" {
					text = "CHARACTER_IDEOLOGY"
				}
				blockoverride "single_text_entry" {}
			}

			textbox = {
				multiline = yes
				size = { 260 40 }
				parentanchor = hcenter
				align = center|nobaseline
				text = "CHARACTER_eafp_bakuhantaisei_politician_influence"
			}
			
			textbox = {
				visible = "[Character.MakeScope.Var('eafp_bakuhantaisei_politician_current_mission').IsSet]"
				multiline = yes
				size = { 260 40 }
				parentanchor = hcenter
				align = center|nobaseline
				text = "CHARACTER_eafp_bakuhantaisei_politician_current_mission"
			}

			#textbox = {
			#	visible = "[InDebugMode]"
			#	multiline = yes
			#	size = { 260 40 }
			#	parentanchor = hcenter
			#	align = center|nobaseline
			#	raw_text = "STDDEV: [Character.MakeScope.Var('CHARACTER_LIFE_EXPECTANCY_STDDEV_value').etValue]"
			#}
		}
	}

    type eafp_japan_regions = container {
        using = sidepanel_plus_sidebar_size
        layoutpolicy_vertical = expanding
        alwaystransparent = no
        using = clickthrough_blocker
        layer = layer_ingame_menu

        flowcontainer = {
            direction = vertical
            spacing = 12
            margin = { 10 10 }
            textbox = {
                text = "eafp_japan_regions_text"
                autoresize = yes
                min_width = @panel_width_minus_30
                max_width = @panel_width_minus_30
                multiline = yes
                align = nobaseline
                margin = { 15 15 }
                background = { using = entry_bg }
            }
            # One UI-only toggle for the entire list; unset means collapsed.
            section_header_button = {
                blockoverride "layout" { size = { 504 38 } }
                blockoverride "left_text" { text = "eafp_japan_regions_list_title" }
                blockoverride "onclick" { onclick = "[GetVariableSystem.Toggle('eafp_japan_regions_list_expanded')]" }
                blockoverride "onclick_showmore" { visible = "[Not(GetVariableSystem.Exists('eafp_japan_regions_list_expanded'))]" }
                blockoverride "onclick_showless" { visible = "[GetVariableSystem.Exists('eafp_japan_regions_list_expanded')]" }
            }
            flowcontainer = {
                visible = "[GetVariableSystem.Exists('eafp_japan_regions_list_expanded')]"
                direction = vertical
                spacing = 3
                # map_list_panel-style rows: clean button, left title, right values.
                button = {
                    name = "eafp_japan_region_TOHOKU_row"
                    using = clean_button
                    using = tooltip_es
                    size = { 504 80 }
                    tooltip = "[SelectLocalization(JournalEntry.GetCountry.MakeScope.Var('eafp_japan_region_active_TOHOKU').IsSet, 'eafp_japan_region_TOHOKU_effects_text', 'eafp_japan_region_unavailable')]"
                    background = { using = entry_bg_simple }
                    textbox = {
                        text = "STATE_TOHOKU"
                        position = { 10 0 }
                        parentanchor = left|vcenter
                        size = { 130 56 }
                        multiline = yes
                        align = left|vcenter|nobaseline
                        alwaystransparent = yes
                    }
                    textbox = {
                        visible = "[Not(JournalEntry.GetCountry.MakeScope.Var('eafp_japan_region_active_TOHOKU').IsSet)]"
                        text = "eafp_japan_region_unavailable"
                        position = { 154 0 }
                        parentanchor = left|vcenter
                        size = { 344 56 }
                        multiline = yes
                        alwaystransparent = yes
                    }
                    flowcontainer = {
                        visible = "[JournalEntry.GetCountry.MakeScope.Var('eafp_japan_region_active_TOHOKU').IsSet]"
                        position = { 154 8 }
                        direction = vertical
                        spacing = 4
                        green_progressbar_horizontal = {
                            block "progressbar_size" { size = { 344 30 } }
                            tooltip = "eafp_japan_region_loyalty_TOHOKU_tooltip"
                            blockoverride "values" {
                                min = 0
                                max = 100
                                value = "[JournalEntry.GetCountry.MakeScope.Var('eafp_japan_loyalty_TOHOKU').GetValue]"
                            }
                            textbox = {
                                text = "eafp_japan_region_loyalty_TOHOKU_text"
                                tooltip = "eafp_japan_region_loyalty_TOHOKU_tooltip"
                                autoresize = yes
                                align = nobaseline
                                margin_left = 10
                                parentanchor = vcenter
                            }
                        }
                        bad_progressbar_horizontal = {
                            block "progressbar_size" { size = { 344 30 } }
                            tooltip = "eafp_japan_region_independency_TOHOKU_tooltip"
                            blockoverride "values" {
                                min = 0
                                max = 100
                                value = "[JournalEntry.GetCountry.MakeScope.Var('eafp_japan_independency_TOHOKU').GetValue]"
                            }
                            textbox = {
                                text = "eafp_japan_region_independency_TOHOKU_text"
                                tooltip = "eafp_japan_region_independency_TOHOKU_tooltip"
                                autoresize = yes
                                align = nobaseline
                                margin_left = 10
                                parentanchor = vcenter
                            }
                        }
                    }
                }
                button = {
                    name = "eafp_japan_region_KANTO_row"
                    using = clean_button
                    using = tooltip_es
                    size = { 504 80 }
                    tooltip = "[SelectLocalization(JournalEntry.GetCountry.MakeScope.Var('eafp_japan_region_active_KANTO').IsSet, 'eafp_japan_region_KANTO_effects_text', 'eafp_japan_region_unavailable')]"
                    background = { using = entry_bg_simple }
                    textbox = {
                        text = "STATE_KANTO"
                        position = { 10 0 }
                        parentanchor = left|vcenter
                        size = { 130 56 }
                        multiline = yes
                        align = left|vcenter|nobaseline
                        alwaystransparent = yes
                    }
                    textbox = {
                        visible = "[Not(JournalEntry.GetCountry.MakeScope.Var('eafp_japan_region_active_KANTO').IsSet)]"
                        text = "eafp_japan_region_unavailable"
                        position = { 154 0 }
                        parentanchor = left|vcenter
                        size = { 344 56 }
                        multiline = yes
                        alwaystransparent = yes
                    }
                    flowcontainer = {
