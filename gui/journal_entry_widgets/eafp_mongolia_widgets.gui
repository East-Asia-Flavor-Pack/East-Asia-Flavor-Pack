# Match Japan's Honorable Restoration portrait, frame and ruler-stat layout.
# Read the country-owned officeholder directly; opening a journal never advances succession.
types eafp_mongolia_journal_widgets {
	type eafp_mgl_jebtsundamba_portrait = widget {

		datacontext = "[JournalEntry.GetCountry.MakeScope.Var('eafp_mgl_jebtsundamba_var').GetCharacter]"

		# Religious office before enthronement
		widget = {
			visible = "[Not(JournalEntry.GetCountry.MakeScope.Var('eafp_mgl_bogd_enthroned').IsSet)]"
			size = { 100% 100% }
			position = { 0 1 }
			using = Animation_Character_Panel_Refresh

			widget = {
				size = { 100% 100% }
				visible = yes

				background = {
					texture = "gfx/interface/character_panel/backgrounds/char_role_politician.dds"
					fittype = centercrop
				}
			}
		}

		# Sovereign after enthronement, including a child under regency
		widget = {
			visible = "[JournalEntry.GetCountry.MakeScope.Var('eafp_mgl_bogd_enthroned').IsSet]"
			size = { 100% 100% }
			position = { 0 1 }
			using = Animation_Character_Panel_Refresh

			widget = {
				size = { 100% 100% }
				visible = yes

				background = {
					texture = "gfx/interface/character_panel/backgrounds/char_role_ruler.dds"
					fittype = centercrop
				}
			}
		}

		character_portrait_base_no_mask = {
			datacontext = "[JournalEntry.GetCountry.MakeScope.Var('eafp_mgl_jebtsundamba_var')]"
			ignore_in_debug_draw = yes
			size = { 217 261 } #+37 +21 (space for frame)

			block "character_layout" {
				position = { 50 10 }
				size = { 250 400 }
			}

			blockoverride "portrait_size" {
				block "character_portrait_size" {
					size = { 575 575 }
				}
			}
			blockoverride "portrait_texture" {
				portrait_texture = "[Scope.GetCharacter.GetAnimatedPortrait('ruler_environment', 'camera_body', 'idle', GetPortraitRenderSize(PdxGuiWidget.Self))]"
			}

			blockoverride "portrait_icons" {}

			blockoverride "tooltip" {
				tooltipwidget = {
					FancyTooltip_Character = {
						datacontext = "[Scope.AccessCharacter]"
					}
				}
			}
		}

		icon = {
			using = dark_area
			parentanchor = bottom|hcenter
			size = { 100% 40% }
			alpha = 0.65
			position = { 0 2 }

			modify_texture = {
				texture = "gfx/interface/masks/fade_vertical_top.dds"
				spriteType = Corneredstretched
				spriteborder = { 0 0 }
				blend_mode = alphamultiply
			}
		}

		widget = {
			size = { 100% 100% }

			background = {
				texture = "gfx/interface/character_panel/char_bg_frame.dds"
				margin_left = 18
				margin_right = 10
				margin_bottom = 10
				spriteType = Corneredtiled

				spriteborder_left = 200
				spriteborder_right = 60
				spriteborder_top = 170
				spriteborder_bottom = 180

				texture_density = 2
			}
		}

		character_interactions_button = {
		}
	}

}

flowcontainer = {
	name = "widget_je_eafp_mgl_jebtsundamba"
	ignoreinvisible = yes
	direction = vertical

	### RULER
	flowcontainer = {
		direction = vertical
		visible = "[JournalEntry.GetCountry.MakeScope.Var('eafp_mgl_jebtsundamba_var').IsSet]"

		eafp_mgl_jebtsundamba_portrait = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			minimumsize = { 520 280 }

			blockoverride "character_layout" {
				position = { 0 0 }
				size = { 80% 100% }
			}
			blockoverride "character_portrait_size" {
				size = { 100% 100% }
			}

			# ruler stats
			flowcontainer = {
				parentanchor = right|top
				position = { -8 5 }
				direction = vertical
				spacing = 5

				background = {
					using = dark_area
					alpha = 0.75

					modify_texture = {
						texture = "gfx/interface/masks/fade_horizontal_left_full.dds"
						blend_mode = alphamultiply
					}
				}

				### ROLE
				ruler_stats_entry = {
					tooltip = "CHARACTER_PRIMARY_ROLE_TOOLTIP"

					blockoverride "ruler_icon" {
						widget = {
							size = { 35 35 }
							icon = {
								size = { 100% 100% }
								texture = "gfx/interface/icons/character_role_icons/ruler.dds"
							}
						}
					}
					blockoverride "label" {
						text = "[SelectLocalization(JournalEntry.GetCountry.MakeScope.Var('eafp_mgl_bogd_enthroned').IsSet, 'RULER_TITLE_EAFP_BOGD_KHAN', 'character_role_eafp_jebtsundamba_title')]"
					}
					blockoverride "text" {
						text = "[Character.GetFullName]"
					}
				}
				## INTEREST GROUP
				ruler_stats_entry = {
					datacontext = "[Character.GetInterestGroup]"

					blockoverride "ruler_icon" {
						character_ig_button = {
							size = { 35 35 }
							blockoverride "in_government_icon" {}
						}
					}

					tooltipwidget = {
						FancyTooltip_IG = {}
					}

					blockoverride "label" {
						text = "INTEREST_GROUP"
					}
					blockoverride "text" {
						raw_text = "#v [Character.GetInterestGroup.GetNameNoFormatting]#!"
					}
				}

				### IDEOLOGY
				ruler_stats_entry = {
					datacontext = "[Character.GetIdeology]"

					tooltipwidget = {
						FancyTooltip_Ideology = {}
					}
					blockoverride "icon_texture" {
						texture = "[Ideology.GetTexture]"
					}
					blockoverride "label" {
						text = "IDEOLOGY_CONCEPT"
					}
					blockoverride "text" {
						text = "CHARACTER_IDEOLOGY"
					}
				}
				#POPULARITY
				ruler_stats_entry = {
					tooltip = "PROMINENCE_BREAKDOWN"

					blockoverride "icon_texture" {
						texture = "gfx/interface/icons/generic_icons/prominence.dds"
					}
					blockoverride "label" {
						text = "PROMINENCE"
					}
					blockoverride "text" {
						text = "CHARACTER_PROMINENCE"
					}
				}

				### TRAITS
				character_traits_no_label = {
					parentanchor = right
				}
			}
		}
	}

	textbox = {
		visible = "[Not(JournalEntry.GetCountry.MakeScope.Var('eafp_mgl_jebtsundamba_var').IsSet)]"
		autoresize = yes
		max_width = 520
		text = "[SelectLocalization(JournalEntry.GetCountry.MakeScope.Var('eafp_mgl_eighth_succession_closed').IsSet, 'eafp_mgl_jebtsundamba_line_ended', 'eafp_mgl_jebtsundamba_not_installed')]"
	}
}
