flowcontainer = {
    name = "eafp_korea_scramble_influence"
    direction = vertical
    spacing = 8
    margin = { 10 10 }
    textbox = { text = "korea_scramble_gui_heading" autoresize = yes }
    # The parent JE panel scrolls this entire list. Country is supplied by the datamodel.
    dynamicgridbox = {
        datamodel = "[JournalEntry.GetInvolvedCountries]"
        datamodel_wrap = 1
        item = {
            widget = {
                size = { 500 76 }
                small_flag = { position = { 0 10 } }
                textbox = {
                    position = { 65 0 }
                    text = "[Country.GetName]"
                    autoresize = yes
                }
                green_progressbar_horizontal = {
                    position = { 65 28 }
                    block "progressbar_size" { size = { 430 30 } }
                    blockoverride "values" {
                        min = 0
                        max = 100
                        value = "[Country.MakeScope.Var('scramble_for_korea_participants_influence').GetValue]"
                    }
                    tooltip = "korea_scramble_gui_tooltip"
                    textbox = {
                        text = "korea_scramble_gui_value"
                        autoresize = yes
                        parentanchor = vcenter
                        margin_left = 10
                        align = nobaseline
                    }
                }
            }
        }
    }
}
