# Self-contained JE widget: vanilla visual types, no external mod dependency.
# Layout follows the vanilla building browser (grouped rows that expand per entry);
# expansion is client UI state keyed by the actual state ID, never a gameplay variable.
types eafp_concession_widgets {
	type eafp_concession_body = textbox {
		autoresize = yes
		multiline = yes
		minimumsize = { 480 -1 }
		maximumsize = { 480 -1 }
		align = left|nobaseline
	}
	type eafp_concession_section = textbox {
		size = { 480 28 }
		align = left|nobaseline
		default_format = "#b"
	}

	# One bar split by every ownership entry of the concession building, coloured and
	# flagged by the owning country (modelled on the vanilla leverage advantage bar and
	# building_ownership_stacked_barchart). Datacontext: Building.
	type eafp_concession_ownership_bar = v3_stacked_barchart {
		size = { 480 36 }

		blockoverride "barchart_datamodel" {
			datamodel = "[Building.GetBuildingOwnerships]"
		}
		blockoverride "barchart_item_margins" {
			margin = { 0 0 }
		}
		blockoverride "barchart_item_stretchfactor" {
			layoutstretchfactor_horizontal = "[FixedPointToInt(Multiply_CFixedPoint(BuildingOwnership.GetOwnershipRatio, '(CFixedPoint)100'))]"
		}
		blockoverride "barchart_item_tooltip" {}
		# The colour depends on who owns the entry, so it is drawn by the segment below.
		blockoverride "barchart_item_background" {}
		blockoverride "barchart_item_icon" {
			# Concession levels are only ever owned by a concession company.
			eafp_concession_owner_segment = {
				datacontext = "[BuildingOwnership.GetOwnerBuilding.GetCompany]"
			}
		}
	}

	# Datacontext: Company (owner) and BuildingOwnership (entry). Coloured by the company's
	# country; the flag opens the country panel and the logo the company panel.
	type eafp_concession_owner_segment = widget {
		layoutpolicy_horizontal = expanding
		layoutpolicy_vertical = expanding
		tooltip = "eafp_concession_owner_share_tt"
		background = {
			texture = "gfx/interface/tooltip/stacked_barchart_small_item.dds"
			color = "[Company.GetCountry.GetMapColor]"
			spriteborder = { 3 3 }
			using = simple_frame_mask
			using = progressbar_texture_properties
		}
		flowcontainer = {
			parentanchor = center
			spacing = 4
			button = {
				datacontext = "[Company.GetCountry]"
				size = { 27 18 }
				parentanchor = vcenter
				onclick = "[InformationPanelBar.OpenCountryPanel(Country.Self)]"
				tooltipwidget = {
					FancyTooltip_Country = {}
				}
				tiny_flag_no_interact = {
					blockoverride "tooltip" {}
				}
			}
			button = {
				size = { 26 26 }
				parentanchor = vcenter
				texture = "[Company.GetCompanyType.GetIcon]"
				onclick = "[InformationPanelBar.OpenCompanyPanel(Company.Self)]"
				tooltipwidget = {
					FancyTooltip_Company = {}
				}
			}
		}
	}

	# Owner legend row under the bar: one concession company per row.
	# Datacontext: BuildingOwnership (entry) and Company (owner).
	# Width: 8 + 330 + 110 + 8 + 3 x spacing 8 = 480 (details content width).
	type eafp_concession_owner_row = flowcontainer {
		datacontext = "[BuildingOwnership.GetOwnerBuilding.GetCompany]"
		spacing = 8
		background = { using = entry_bg }
		widget = {
			size = { 8 48 }
			background = { using = entry_bg_simple_colored color = "[Company.GetCountry.GetMapColor]" }
		}
		textbox = {
			size = { 330 48 }
			multiline = yes
			elide = right
			text = "eafp_concession_company_asset"
			tooltip = "eafp_concession_company_asset_tt"
		}
		textbox = {
			size = { 110 48 }
			align = right|nobaseline
			multiline = yes
			text = "eafp_concession_asset_amount"
		}
		widget = {
			size = { 8 48 }
			background = { using = entry_bg_simple_colored color = "[Company.GetCountry.GetMapColor]" }
		}
	}

	type eafp_concession_state_rows = flowcontainer {
		direction = vertical
		spacing = 6
		ignoreinvisible = yes
		datamodel = "[GetGlobalList('concession_candidate_states_gvarlist')]"
		item = {
			flowcontainer = {
				datacontext = "[Scope.GetState]"
				visible = "[GetScriptedGui('eafp_concession_state_row').IsShown(GuiScope.SetRoot(State.MakeScope).End)]"
				direction = vertical
				ignoreinvisible = yes
				minimumsize = { 480 -1 }
				background = { using = entry_bg_simple }

				### ROW HEADER: flag + state, current / cap, go-to buttons
				container = {
					flowcontainer = {
						spacing = 4
						margin = { 6 4 }
						section_header_button = {
							blockoverride "layout" { size = { 412 38 } }
							blockoverride "fontsize" { using = fontsize_medium }
							blockoverride "left_text" { raw_text = "[State.GetOwner.GetFlagTextIcon] [State.GetName]" }
							blockoverride "right_text" {
								section_header_right_text = {
									text = "eafp_concession_card_total"
									tooltip = "eafp_concession_cap_tt"
								}
							}
							blockoverride "onclick" {
								onclick = "[GetVariableSystem.Toggle(Concatenate('eafp_concession_state_', State.GetIDString))]"
							}
							blockoverride "onclick_showmore" {
								visible = "[Not(GetVariableSystem.Exists(Concatenate('eafp_concession_state_', State.GetIDString)))]"
							}
							blockoverride "onclick_showless" {
								visible = "[GetVariableSystem.Exists(Concatenate('eafp_concession_state_', State.GetIDString))]"
							}
						}
						widget = {
							size = { 34 38 }
							button_icon_goto = {
								parentanchor = center
								size = { 30 30 }
								onclick = "[InformationPanelBar.OpenStatePanel(State.AccessSelf)]"
								tooltipwidget = {
									FancyTooltip_State = {}
								}
							}
						}
						widget = {
							size = { 34 38 }
							button_icon_round = {
								datacontext = "[State.GetBuilding('building_eafp_concession')]"
								parentanchor = center
								size = { 30 30 }
								enabled = "[Building.IsValid]"
								onclick = "[InformationPanelBar.OpenBuildingDetailsPanel(Building.AccessSelf)]"
								tooltipwidget = {
									FancyTooltip_Building = {}
								}
								blockoverride "icon" {
									texture = "gfx/interface/icons/building_icons/building_trade_center.dds"
								}
							}
						}
					}
					divider_clean = {
						visible = "[GetVariableSystem.Exists(Concatenate('eafp_concession_state_', State.GetIDString))]"
						parentanchor = bottom|hcenter
						position = { 0 -2 }
					}
				}

				### browser's construction section (background dark_area).
				flowcontainer = {
					visible = "[GetVariableSystem.Exists(Concatenate('eafp_concession_state_', State.GetIDString))]"
					direction = vertical
					spacing = 6
					margin = { 10 8 }
					minimumsize = { 500 -1 }
					ignoreinvisible = yes
					background = { using = dark_area }

					### Ownership by country: one bar + legend
					eafp_concession_section = { text = "eafp_concession_ownership_heading" }
					eafp_concession_ownership_bar = {
						datacontext = "[State.GetBuilding('building_eafp_concession')]"
						visible = "[State.GetBuilding('building_eafp_concession').IsValid]"
					}
					flowcontainer = {
						direction = vertical
						spacing = 3
						visible = "[State.GetBuilding('building_eafp_concession').IsValid]"
						datamodel = "[State.GetBuilding('building_eafp_concession').GetBuildingOwnerships]"
						item = {
							eafp_concession_owner_row = {}
						}
					}

					### Expansion
					divider_clean = { size = { 480 1 } }
					button = {
						using = default_button
						size = { 480 38 }
						visible = "[GetScriptedGui('eafp_concession_expand_gui').IsShown(GuiScope.SetRoot(State.MakeScope).AddScope('actor', GetPlayer.MakeScope).End)]"
						enabled = "[GetScriptedGui('eafp_concession_expand_gui').IsValid(GuiScope.SetRoot(State.MakeScope).AddScope('actor', GetPlayer.MakeScope).End)]"
						# Vanilla JE action format (SCRIPTED_ACTION_TOOLTIP): requirements, then effects.
						tooltip = "eafp_concession_expand_button_tt"
						onclick = "[GetScriptedGui('eafp_concession_expand_gui').Execute(GuiScope.SetRoot(State.MakeScope).AddScope('actor', GetPlayer.MakeScope).End)]"
						text = "eafp_concession_expand_label"
					}
				}
			}
		}
	}
}
flowcontainer = {
	name = "widget_eafp_concessions"
	direction = vertical
	ignoreinvisible = yes
	# Fixed width and frame of the vanilla JE containers (reason / involved countries):
	# @panel_width_minus_30 = 510, default_list_position, entry_bg.
	using = default_list_position
	min_width = 510
	max_width = 510
	margin = { 5 5 }
	background = { using = entry_bg }
	eafp_concession_state_rows = {}
}
